{
  "expo": {
    "name": "Gemeinsam Wohnen",
    "slug": "gemeinsam_wohnen",
    "scheme": "gemeinsamwohnen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kipry.gemeinsamwohnen",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      }
    },
    "android": {
      "package": "com.kipry.gemeinsamwohnen",
      "adaptiveIcon": {
        "backgroundColor": "#5B5FEF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Damit du ein Foto vom Kassenbon an eine Ausgabe hängen kannst.",
          "cameraPermission": "Damit du den Kassenbon direkt an der Kasse abfotografieren kannst.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#5B5FEF",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#0F0F14"
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "582e9de3-2b76-4547-a082-cb867ad3f5c6"
      }
    },
    "owner": "kipry"
  }
}
